# ── Required ─────────────────────────────────────────────────────────────
# Anthropic — powers all 5 Opus 4.7 agents
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional integrations ────────────────────────────────────────────────
# Supabase — enables persistence for /leads, /dashboard
SUPABASE_URL=
SUPABASE_KEY=

# Resend — enables Action Executor to actually send follow-up emails
RESEND_API_KEY=

# Telegram — enables hot-lead notifications to your phone
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq — enables V2 Beta: voice-call → Whisper transcription → pipeline
GROQ_API_KEY=

# HubSpot — V2 CRM sync (HOT/WARM leads create real contact + deal in HubSpot)
# Get a Private App token: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read/write + crm.objects.deals.read/write
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_REGION=eu1

# ElevenLabs — Jarvis voice (sentence-boundary streaming TTS).
# https://elevenlabs.io/app/settings/api-keys
# Default voice: Daniel (British male, ~40s) — voice_id onwK4e9ZLuTAKqWW03F9.
# Default model: eleven_turbo_v2_5 — best latency/quality trade-off.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── Frontend → backend wiring ───────────────────────────────────────────
# Frontend reads this to know where the FastAPI backend is. Vercel injects
# the deployed Railway URL here at build time; locally it falls back to
# http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
